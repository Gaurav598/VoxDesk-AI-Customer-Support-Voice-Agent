APP_ENV=local
VOICE_AGENT_API_TOKEN=change-me

# Storage
VOICE_AGENT_DB_PATH=backend/data/voice_agent.db
DATABASE_URL=postgresql://voice_agent:voice_agent@localhost:5432/voice_agent
REDIS_URL=redis://localhost:6379/0

# LLM
VOICE_AGENT_LLM=fallback
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b

# Text to speech
TTS_PROVIDER=fish
FISH_API_KEY=
FISH_TTS_MODEL=s2.1-pro-free
FISH_REFERENCE_ID=
FISH_TTS_LATENCY=balanced
FISH_TTS_SPEED=1

# Optional local Fish-compatible TTS server
FISH_LOCAL_URL=http://127.0.0.1:8081
FISH_LOCAL_ENDPOINT=/v1/tts
FISH_LOCAL_API_KEY=
FISH_LOCAL_REFERENCE_ID=
FISH_LOCAL_FORMAT=wav

# Local audio adapters
STT_PROVIDER=faster_whisper
WHISPER_MODEL=small

# Integrations
WHATSAPP_DRY_RUN=true
EXOTEL_DRY_RUN=true
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.exotel.com
